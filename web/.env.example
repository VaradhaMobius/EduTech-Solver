# Required for live handwriting grading (OpenAI vision).
# On Vercel: Project → Settings → Environment Variables (Production + Preview).
# Never commit real keys. Never use a NEXT_PUBLIC_ prefix for this value.
OPENAI_API_KEY=

# Optional override (default: gpt-4o)
OPENAI_VISION_MODEL=gpt-4o

# Rate limits for POST /api/grade (per client IP)
GRADE_RATE_LIMIT_PER_MINUTE=8
GRADE_RATE_LIMIT_PER_HOUR=40

# OpenAI call timeout (ms)
GRADE_TIMEOUT_MS=45000

# Optional: comma-separated extra allowed origins for grading POSTs in production
# GRADE_ALLOWED_ORIGINS=https://your-custom-domain.com

# Optional durable rate limiting across Vercel instances (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Dev-only escape hatch (do not enable in production)
# GRADE_ALLOW_NO_ORIGIN=1
